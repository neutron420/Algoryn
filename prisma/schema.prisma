generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CodingPlatform {
  LEETCODE
  GEEKSFORGEEKS
  CODECHEF
  ATCODER
  CODEFORCES
  HACKERRANK
  HACKEREARTH
  CODESTUDIO
  INTERVIEWBIT
  CUSTOM
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems          CompanyProblem[]
  userTargets       UserTargetCompany[]
  communityProblems CommunityProblem[]
}

model Problem {
  id             Int        @id @default(autoincrement())
  leetcodeId     String     @unique
  leetcodeNumber Int?
  title          String
  slug           String     @unique
  difficulty     Difficulty
  leetcodeUrl    String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  companies  CompanyProblem[]
  topics     ProblemTopic[]
  userSolved UserSolvedProblem[]

  @@index([difficulty])
}

model CompanyProblem {
  id        Int      @id @default(autoincrement())
  companyId Int
  problemId Int
  timeframe String?  @default("ALL")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([companyId, problemId])
  @@index([problemId])
}

model Topic {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  problems ProblemTopic[]

  createdAt DateTime @default(now())
}

model ProblemTopic {
  id        Int      @id @default(autoincrement())
  problemId Int
  topicId   Int
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([problemId, topicId])
  @@index([topicId])
}

model User {
  id          String   @id // Firebase UID
  email       String?  @unique
  phoneNumber String?  @unique
  displayName String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targets            UserTargetCompany[]
  solved             UserSolvedProblem[]
  bookmarks          UserBookmarkProblem[]
  submissions        CommunityProblem[]
  discussionPosts    DiscussionPost[]
  discussionComments DiscussionComment[]
  platformAccounts   UserPlatformAccount[]
  leaderboardEntry   LeaderboardEntry?
}

model UserTargetCompany {
  id        Int      @id @default(autoincrement())
  userId    String
  companyId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

model UserSolvedProblem {
  id        Int      @id @default(autoincrement())
  userId    String
  problemId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model UserBookmarkProblem {
  id        Int      @id @default(autoincrement())
  userId    String
  problemId Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model CommunityProblem {
  id             Int            @id @default(autoincrement())
  companyId      Int
  userId         String?
  platform       CodingPlatform @default(LEETCODE)
  title          String
  problemUrl     String?
  difficulty     Difficulty     @default(MEDIUM)
  roundType      String
  interviewMonth String?
  interviewYear  Int?
  timeframe      String?        @default("ALL")
  topics         String[]
  notes          String?
  upvotes        Int            @default(1)
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
}

model DiscussionPost {
  id             String   @id @default(cuid())
  userId         String?
  authorName     String   @default("Coder")
  authorHandle   String?
  authorRole     String?
  avatarUrl      String?
  title          String?
  content        String
  imageUrl       String?
  category       String   @default("General")
  tags           String[] @default([])
  viewsCount     Int      @default(0)
  likesCount     Int      @default(0)
  bookmarksCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  likes     DiscussionLike[]
  bookmarks DiscussionBookmark[]
  comments  DiscussionComment[]

  @@index([createdAt])
  @@index([category])
}

model DiscussionComment {
  id            String   @id @default(cuid())
  postId        String
  userId        String?
  authorName    String   @default("Coder")
  authorHandle  String?
  avatarUrl     String?
  content       String
  parentId      String?
  likesCount    Int      @default(0)
  dislikesCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  post    DiscussionPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  DiscussionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
  @@index([createdAt])
}

model DiscussionLike {
  id        Int      @id @default(autoincrement())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model DiscussionBookmark {
  id        Int      @id @default(autoincrement())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model UserPlatformAccount {
  id           Int            @id @default(autoincrement())
  userId       String
  platform     CodingPlatform
  username     String
  isVerified   Boolean        @default(false)
  lastSyncedAt DateTime?
  syncError    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats UserPlatformStats[]

  @@unique([userId, platform])
  @@index([userId])
}

model UserPlatformStats {
  id            Int            @id @default(autoincrement())
  accountId     Int
  platform      CodingPlatform
  totalSolved   Int            @default(0)
  easySolved    Int            @default(0)
  mediumSolved  Int            @default(0)
  hardSolved    Int            @default(0)
  rating        Int?
  rank          String?
  contestsCount Int?
  contributions Int?
  score         Int?
  rawData       Json?
  fetchedAt     DateTime       @default(now())

  account UserPlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([platform])
}

model LeaderboardEntry {
  id                Int      @id @default(autoincrement())
  userId            String   @unique
  displayName       String?
  photoUrl          String?
  leetcodeScore     Int      @default(0)
  codeforcesScore   Int      @default(0)
  codechefScore     Int      @default(0)
  atcoderScore      Int      @default(0)
  gfgScore          Int      @default(0)
  hackerrankScore   Int      @default(0)
  hackerearthScore  Int      @default(0)
  interviewbitScore Int      @default(0)
  totalScore        Int      @default(0)
  globalRank        Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([globalRank])
  @@index([totalScore])
}

model LeaderboardRun {
  id        Int      @id @default(autoincrement())
  runId     String   @unique
  label     String
  fromDate  DateTime
  toDate    DateTime
  snapshot  Json
  createdAt DateTime @default(now())
}
